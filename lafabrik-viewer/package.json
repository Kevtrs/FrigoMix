{
  "name": "lafabrik-viewer",
  "version": "0.1.0",
  "description": "Visionneuse 3D e-commerce LaFabrik — cadres RÖDALM avec reliefs imprimés en 3D",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.embed.config.js",
    "preview": "vite preview --port 4173",
    "build:frame": "node tools/build-frame.mjs",
    "import": "node tools/import-relief.mjs",
    "textures": "node tools/prepare-textures.mjs",
    "new-product": "node tools/new-product.mjs",
    "placeholder": "node tools/make-placeholder.mjs",
    "posters": "node tools/posters.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "fflate": "^0.8.3",
    "lil-gui": "^0.21.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.5"
  },
  "private": true,
  "type": "module"
}
